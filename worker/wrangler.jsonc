{
  "name": "stile-edge-enquiry",
  "main": "src/index.js",
  "compatibility_date": "2026-09-16",

	"secrets": {
    "required": [
        "TURNSTILE_SECRET"
	    ]
	},

  "send_email": [
    {
      "name": "EMAIL",
      "destination_address": "sales@stileedge.com"
    }
  ],

  "vars": {
    "FROM_EMAIL": "website@notify.stileedge.com",
    "TO_EMAIL": "sales@stileedge.com",
    "ALLOWED_ORIGINS": "https://abrahamtilbury.github.io,https://stileedge.com,https://www.stileedge.com",
    "TURNSTILE_HOSTNAMES": "abrahamtilbury.github.io,stileedge.com,www.stileedge.com"
  }
}
